# Install with your actual API hostname and TLS certificate paths.
# Only the ingress should expose ports 80/443. The API binds 127.0.0.1:8000.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name YOUR_API_HOST;
    ssl_certificate /etc/letsencrypt/live/YOUR_API_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_API_HOST/privkey.pem;
    client_max_body_size 6m;
    client_body_timeout 15s;
    keepalive_timeout 15s;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 70s;
        proxy_send_timeout 30s;
    }
}
server {
    listen 80;
    server_name YOUR_API_HOST;
    return 301 https://$host$request_uri;
}
