# Template only. Keep real credentials in your private .env / hosting secrets.
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/DB_NAME?ssl=require
JWT_SECRET_KEY=replace-with-a-cryptographically-random-secret
CORS_ORIGINS=https://YOUR_FRONTEND_HOST
ALLOWED_HOSTS=YOUR_API_HOST,localhost,127.0.0.1
REDIS_URL=redis://redis:6379/0
SQL_ECHO=false
DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
WEB_CONCURRENCY=4
WORKER_CONCURRENCY=400
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
AUTH_RATE_LIMIT=30
USER_RATE_LIMIT=300
IP_RATE_LIMIT=3000
MAX_REQUEST_BYTES=6291456
# Set to the actual trusted ingress proxy IP/CIDR, never arbitrary clients.
FORWARDED_ALLOW_IPS=127.0.0.1
DOCUMENT_STORAGE_PATH=/app/uploads/private
STUDENT_DOCUMENT_STORAGE_PATH=/app/uploads/student_documents
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
